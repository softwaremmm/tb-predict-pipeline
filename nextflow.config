params {
    help = ''
    testing = ''
    publish = ''
}

profiles {
    local {
        docker.fixOwnership = true
        docker.enabled = true
        docker.runOptions = "--network host"
        process {
            debug = false
            executor = 'local'
            maxRetries = 4
            errorStrategy = {
                sleep(5 * Math.pow(2, task.attempt) as long)
                return 'retry'
            }
        }
        env.WORKSPACE = 'offline'
    }

    kubernetes {
        k8s {
            namespace = 'default'
            storageClaimName = 'default-nextflow-fss-storage-work-pvc'
            storageMountPath = '/work'
            launchDir = "/work/runs/${params.sample}"

            serviceAccount = 'default'
            projectDir = '/work/project'
            pod = [
                [label: 'pod-type', value: 'nextflow-worker'],
                [volumeClaim: 'default-nextflow-fss-storage-data-pvc', mountPath: '/data'],
                [imagePullPolicy: 'IfNotPresent']
            ]
        }
        docker.enabled = true
        docker.registry = 'lhr.ocir.io'
        process.executor = 'k8s'
        process.container = 'lrbvkel2wjot/oxfordmmm/gnomonicus:latest'
    }
    docker {
        env.WORKSPACE = 'offline'
        docker.enabled = true
        docker.fixOwnership = true
        docker.runOptions = "-u \$(id -u):\$(id -g)"
        process.cpus = 2
        process.memory = "4GB"
        process.container = "lrbvkel2wjot/oxfordmmm/gnomonicus:latest"
        docker.registry = 'lhr.ocir.io'
    }
}
